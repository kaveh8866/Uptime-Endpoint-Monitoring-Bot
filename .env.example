# =============================================================================
# Uptime Endpoint Monitoring Bot — environment template
# =============================================================================
# Copy to `.env` (never committed), fill in the channels you actually use, then:
#   docker compose --env-file .env -f docker/docker-compose.yml up -d --build
#
# Every value below is a placeholder. No real token belongs in this file.

# --- Paths (inside the container) --------------------------------------------
ENDPOINTS_FILE=/app/configs/endpoints.yaml
THRESHOLDS_FILE=/app/configs/thresholds.yaml
STATE_DB_PATH=/data/uptime.db

# --- Behaviour ---------------------------------------------------------------
HISTORY_RETENTION_DAYS=14
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=1
LOG_LEVEL=INFO

# --- Notification channels (all optional; empty means log-only) --------------
# The values below are non-empty placeholders so the file is self-documenting:
# BLANK any channel you do not use, otherwise the bot treats it as configured and
# tries to deliver to example.invalid on the first incident.
# Any JSON endpoint: Slack, Teams, n8n, Grafana, or your own receiver.
ALERT_WEBHOOK_URL=https://example.invalid/cloudguard-uptime-alert
# Telegram: create a bot with BotFather, then send it one message to obtain the chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Discord: Server settings -> Integrations -> Webhooks -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# --- Runtime -----------------------------------------------------------------
TZ=UTC
