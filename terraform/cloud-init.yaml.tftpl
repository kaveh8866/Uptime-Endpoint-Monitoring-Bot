#cloud-config
# =============================================================================
# Uptime Endpoint Monitoring Bot — first-boot bootstrap (${project_name})
# =============================================================================
# Prepares the host and stops there. No credential, no repository URL, no
# endpoint list: the compose stack and its configuration are deployed over SSH,
# so a leaked user-data blob reveals nothing about your monitored services.

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git

write_files:
  - path: /etc/motd
    content: |
      ${project_name} — monitoring host
      Deploy the bot:
        git clone https://github.com/kaveh8866/Uptime-Endpoint-Monitoring-Bot.git
        cd Uptime-Endpoint-Monitoring-Bot && cp .env.example .env
        docker compose --env-file .env -f docker/docker-compose.yml up -d --build
    permissions: "0644"

runcmd:
  # Docker Engine + Compose plugin from the official convenience script. Pinned
  # to the distribution package repository rather than a distro snapshot so the
  # host receives security updates with `apt upgrade`.
  - curl -fsSL https://get.docker.com -o /tmp/get-docker.sh
  - sh /tmp/get-docker.sh
  - usermod -aG docker ubuntu
  - systemctl enable --now docker
  - mkdir -p /opt/${project_name}
  - chown ubuntu:ubuntu /opt/${project_name}

  # Unattended security upgrades: the bot is a long-running, low-touch host.
  - apt-get install -y unattended-upgrades
  - dpkg-reconfigure -f noninteractive unattended-upgrades

final_message: "${project_name} host ready after $UPTIME seconds"
